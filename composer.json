{
    "name": "jakobbsm/spreadsheet-converter",
    "description": "Fast streaming CSV/XLSX conversion for PHP, backed by a bundled native executable (no .NET runtime required).",
    "type": "library",
    "license": "MIT",
    "keywords": ["xlsx", "csv", "excel", "spreadsheet", "export", "import"],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Jakobbsm\\SpreadsheetConverter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jakobbsm\\SpreadsheetConverter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
